{
  "manifest_version": 3,
  "name": "WikiTree Riksarkivet Linker",
  "version": "0.1",
  "description": "Annotate Riksarkivet images with WikiTree profiles",
  "permissions": ["storage"],
  "host_permissions": [
    "https://sok.riksarkivet.se/*",
    "https://api.wikitree.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.wikitree.com/*"],
      "js": ["wikitree.js"]
    },
    {
      "matches": ["https://sok.riksarkivet.se/bildvisning/*"],
      "js": ["content.js"]
    }
  ]
}
