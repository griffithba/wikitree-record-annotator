{
  "manifest_version": 3,
  "name": "WikiTree Record Annotator",
  "version": "0.3.2.3",
  "description": "Annotate record images with WikiTree profiles",
  "action": {
    "default_title": "WikiTree Record Annotator",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.wikitree.com/*",
    "https://plus.wikitree.com/*"
  ],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  
  "content_scripts": [
    {
      "matches": ["https://www.wikitree.com/wiki/*"],
      "js": [
        "src/sites/riksarkivet.js", 
        "src/sites/matricula.js",
        "src/wtplus.js",
        "src/wikitree.js"
      ]
    },
    {
      "matches": ["https://sok.riksarkivet.se/bildvisning/*"],
      "js": [
        "src/sites/riksarkivet.js",
        "src/theme.js",
        "src/tools.js",
        "src/wtplus.js",
        "src/annotations.js",
        "src/overlay.js",
        "src/ui.js",
        "src/person.js",
        "src/content.js"
      ]
    },
    {
      "matches": ["https://data.matricula-online.eu/*"],
      "js": [
        "src/sites/matricula.js",
        "src/theme.js",
        "src/tools.js",
        "src/wtplus.js",
        "src/annotations.js",
        "src/overlay.js",
        "src/ui.js",
        "src/person.js",
        "src/content.js" 
      ] 
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "src/sites/riksarkivet-page.js"
      ],
      "matches": [
        "https://sok.riksarkivet.se/*"
      ]
    },
    {
      "resources": [
        "src/sites/matricula-page.js"
      ],
      "matches": [
        "https://data.matricula-online.eu/*"
      ]
    },
    {
      "resources": [
        "src/background/suggestions.html",
        "src/background/suggestions.js"
      ],
      "matches": [
        "https://www.wikitree.com/*"
      ]
    },
    {
      "resources": [
        "icons/*.png"
      ],
      "matches": [
        "https://www.wikitree.com/*",
        "https://sok.riksarkivet.se/*",
        "https://data.matricula-online.eu/*"
      ]
    }
  ]

}
