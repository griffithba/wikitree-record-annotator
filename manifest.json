{
  "manifest_version": 3,
  "name": "WikiTree Record Annotator",
  "version": "0.1",
  "description": "Annotate record images with WikiTree profiles",
  "action": {
    "default_title": "WikiTree Record Annotator",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.wikitree.com/*"
  ],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "src/background.js"
  },
  
  "content_scripts": [
    {
      "matches": ["https://www.wikitree.com/wiki/*"],
      "js": [
        "src/storage.js", 
        "src/sites/riksarkivet.js", 
        "src/wikitree.js"]
    },
    {
      "matches": ["https://sok.riksarkivet.se/bildvisning/*"],
      "js": [
        "src/theme.js",
        "src/tools.js",
        "src/ui.js",
        "src/storage.js", 
        "src/person.js",
        "src/sampleAnnotations.js", 
        "src/sites/riksarkivet.js", 
        "src/content.js"]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "src/suggestions.html",
        "src/suggestions.js",
        "icons/*.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]

}
