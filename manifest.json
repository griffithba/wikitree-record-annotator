{
  "manifest_version": 3,
  "name": "WikiTree Record Annotator",
  "version": "0.1",
  "description": "Annotate record images with WikiTree profiles",
  "action": {"default_title": "WikiTree Record Annotator"}
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.wikitree.com/*"
  ],

  "background": {
    "service_worker": "src/background.js"
  },
  
  "content_scripts": [
    {
      "matches": ["https://www.wikitree.com/wiki/*"],
      "js": ["src/storage.js", "src/wikitree.js"]
    },
    {
      "matches": ["https://sok.riksarkivet.se/bildvisning/*"],
      "js": ["src/storage.js", "src/sampleAnnotations.js", "src/sites/riksarkivet.js", "src/content.js"]
    }
  ]
}
